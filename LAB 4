using UnityEngine;

public class Ejercicio3 : MonoBehaviour
{
    public int vidaActual;
    public int dañoRecibido;

    void Start()
    {
        int vidaRestante = vidaActual - dañoRecibido;

        if (dañoRecibido < 30)
        {
            Debug.Log("jugador estable");
        }

        else if (vidaRestante >= 1 && vidaRestante <= 30)
        {
            Debug.Log("Jugador en peligro");
        }
        else
        {
            Debug.Log("game over");
        }
    }

    // Update is called once per frame
    void Update()
    {
        
    }
}
